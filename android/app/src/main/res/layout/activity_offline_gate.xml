<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen overlay MainActivity.java adds on top of the WebView (never instead of it) when the
  app launches with no validated internet connection — see the comment on showOfflineGate() there
  for why this exists and why it's a plain native View instead of anything JS-side.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0B1A24"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:padding="32dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@mipmap/ic_launcher_foreground"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/offline_gate_title"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/offline_gate_message"
        android:textColor="#B0BEC5"
        android:textSize="14sp" />

    <Button
        android:id="@+id/offline_gate_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#277134"
        android:textColor="#FFFFFF"
        android:text="@string/offline_gate_retry" />

</LinearLayout>
